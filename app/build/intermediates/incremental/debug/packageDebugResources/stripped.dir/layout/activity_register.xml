<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingTop="56dp" android:paddingBottom="48dp"
        android:paddingLeft="28dp" android:paddingRight="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back" android:background="?attr/selectableItemBackgroundBorderless"
                android:alpha="0.8" android:contentDescription="Indietro"/>
        </LinearLayout>

        <FrameLayout android:layout_width="96dp" android:layout_height="96dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="14dp">
            <View android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_avatar_circle"/>
            <ImageView android:layout_width="80dp" android:layout_height="80dp"
                android:layout_gravity="center" android:src="@drawable/cby_avatar"/>
        </FrameLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Crea il tuo account" android:textColor="#FFFFFF"
            android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="7 giorni gratis • nessuna carta subito" android:textColor="#80FFFFFF"
            android:textSize="12sp" android:layout_marginBottom="32dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/bg_field" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:layout_marginBottom="12dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_person" android:alpha="0.55" android:layout_marginEnd="12dp"/>
            <EditText android:id="@+id/etName" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:hint="Nome completo *" android:textColorHint="#73FFFFFF"
                android:textColor="#FFFFFF" android:inputType="textPersonName|textCapWords"
                android:background="@null" android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/bg_field" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:layout_marginBottom="12dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_email" android:alpha="0.55" android:layout_marginEnd="12dp"/>
            <EditText android:id="@+id/etEmail" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:hint="Email *" android:textColorHint="#73FFFFFF"
                android:textColor="#FFFFFF" android:inputType="textEmailAddress"
                android:background="@null" android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/bg_field" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:layout_marginBottom="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_lock" android:alpha="0.55" android:layout_marginEnd="12dp"/>
            <EditText android:id="@+id/etPassword" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:hint="Password * (min. 8 caratteri)" android:textColorHint="#73FFFFFF"
                android:textColor="#FFFFFF" android:inputType="textPassword"
                android:background="@null" android:textSize="15sp"/>
            <ImageButton android:id="@+id/btnTogglePwd" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_eye" android:background="@null" android:alpha="0.45"
                android:contentDescription="Mostra password"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/strengthBar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingTop="4dp" android:layout_marginBottom="12dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="4dp"
                android:orientation="horizontal" android:weightSum="4">
                <View android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#FFFFFF26" android:layout_marginEnd="3dp"/>
                <View android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#FFFFFF26" android:layout_marginEnd="3dp"/>
                <View android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#FFFFFF26" android:layout_marginEnd="3dp"/>
                <View android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#FFFFFF26"/>
            </LinearLayout>
            <TextView android:id="@+id/tvPasswordStrength" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/bg_field" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:layout_marginBottom="18dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_lock" android:alpha="0.55" android:layout_marginEnd="12dp"/>
            <EditText android:id="@+id/etConfirmPassword" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:hint="Conferma password *" android:textColorHint="#73FFFFFF"
                android:textColor="#FFFFFF" android:inputType="textPassword"
                android:background="@null" android:textSize="15sp"/>
        </LinearLayout>

        <CheckBox android:id="@+id/cbPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Accetto la Privacy Policy *" android:textColor="#99FFFFFF"
            android:buttonTint="#00D4FF" android:textSize="13sp" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/cbTerms" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Accetto i Termini di Servizio *" android:textColor="#99FFFFFF"
            android:buttonTint="#00D4FF" android:textSize="13sp" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/cbMarketing" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Acconsento al marketing (facoltativo)" android:textColor="#66FFFFFF"
            android:buttonTint="#00D4FF" android:textSize="13sp" android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Crea account" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"
            android:background="@drawable/bg_button_gradient" android:layout_marginBottom="16dp"/>

        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:visibility="gone"
            android:indeterminateTint="#00D4FF" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hai già un account? " android:textColor="#80FFFFFF" android:textSize="14sp"/>
            <TextView android:id="@+id/btnLogin" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Accedi"
                android:textColor="#00D4FF" android:textSize="14sp" android:textStyle="bold" android:padding="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>