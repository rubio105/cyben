<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D1A">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous" android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Health Prohmed" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/progressProhmed" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:layout_gravity="center_horizontal"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRO" android:textColor="#2979FF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HMED" android:textColor="#4CAF50" android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEDICAL INTELLIGENCE PREVENTION" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginBottom="16dp"/>
            <TextView android:id="@+id/tvProhmedTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attiva il tuo profilo" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvProhmedSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="16dp"/>
            <!-- Activate form -->
            <LinearLayout android:id="@+id/layoutActivate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/settings_card_bg" android:padding="16dp" android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dati personali" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <android.widget.EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nome completo" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/surface_variant" android:layout_marginBottom="8dp"/>
                <android.widget.EditText android:id="@+id/etFiscalCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Codice fiscale" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/surface_variant" android:layout_marginBottom="8dp" android:inputType="textCapCharacters"/>
                <android.widget.EditText android:id="@+id/etBirthDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Data di nascita (YYYY-MM-DD)" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/surface_variant" android:layout_marginBottom="8dp"/>
                <android.widget.EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Telefono" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/surface_variant" android:inputType="phone" android:layout_marginBottom="16dp"/>
                <Button android:id="@+id/btnActivate" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Attiva Prohmed" android:backgroundTint="#2979FF" android:textColor="@color/white"/>
            </LinearLayout>
            <!-- Consult form -->
            <LinearLayout android:id="@+id/layoutConsult" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/settings_card_bg" android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Richiedi consulto" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Specialita'" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <Spinner android:id="@+id/spinnerSpecialty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:backgroundTint="@color/surface_variant" android:layout_marginBottom="12dp"/>
                <android.widget.EditText android:id="@+id/etConsultDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Descrivi il tuo problema" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                    android:backgroundTint="@color/surface_variant" android:inputType="textMultiLine" android:minLines="3" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Urgenza" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <Spinner android:id="@+id/spinnerUrgency" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:backgroundTint="@color/surface_variant" android:layout_marginBottom="16dp"/>
                <Button android:id="@+id/btnConsult" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Richiedi consulto" android:backgroundTint="#2979FF" android:textColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>