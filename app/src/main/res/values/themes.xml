<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CybenGuard.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.CybenGuard</item>
    </style>

    <style name="Theme.CybenGuard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyben_orange</item>
        <item name="colorPrimaryVariant">@color/cyben_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/cyben_surface</item>
        <item name="android:windowBackground">@color/cyben_dark</item>
        <item name="android:statusBarColor">@color/cyben_dark</item>
        <item name="android:navigationBarColor">@color/cyben_dark</item>
    </style>

    <style name="Theme.CybenGuard.Splash" parent="Theme.CybenGuard">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>