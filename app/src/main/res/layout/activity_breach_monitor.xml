<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D1A">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous" android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Monitor violazioni" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <!-- Header card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                android:background="@drawable/settings_card_bg" android:layout_marginBottom="20dp">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:text="&#128737;" android:textSize="22sp"
                    android:gravity="center" android:background="@drawable/icon_bg_green" android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvBreachHeader" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Identita sotto controllo" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvBreachSubheader" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0/2 email monitorate · verifica password disponibile"
                        android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <!-- Email monitorate -->
            <TextView android:id="@+id/tvEmailLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email monitorate (0/2)" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp"/>
            <LinearLayout android:id="@+id/layoutEmails" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/settings_card_bg" android:layout_marginBottom="6dp">
                <LinearLayout android:id="@+id/btnAddEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:text="+" android:textSize="20sp"
                        android:gravity="center" android:textColor="#00BCD4" android:background="@drawable/icon_bg_blue"
                        android:layout_marginEnd="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Aggiungi email" android:textColor="#00BCD4" android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEmails"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginBottom="20dp"/>
            <!-- Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Password" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp"/>
            <LinearLayout android:id="@+id/btnHibp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
                android:background="@drawable/settings_card_bg" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="&#128273;" android:textSize="18sp"
                    android:gravity="center" android:background="@drawable/icon_bg_orange" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Verifica password" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Controlla se una password compare in violazioni note"
                        android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="@color/text_secondary" android:textSize="16sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Controlla se una password e' gia' apparsa in violazioni note senza inviarla in chiaro."
                android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="12dp" android:layout_marginStart="4dp"/>
            <!-- Breach status -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
                android:background="@drawable/settings_card_bg" android:layout_marginBottom="20dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="&#10004;" android:textSize="12sp"
                    android:gravity="center" android:textColor="@color/white" android:background="@drawable/circle_green" android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/tvBreachStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nessuna rilevata" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/progressBreach" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_gravity="center_horizontal"/>
            <!-- Breach alerts list -->
            <TextView android:id="@+id/tvBreachAlertsLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Violazioni rilevate" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="8dp" android:layout_marginStart="4dp"
                android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBreachAlerts"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginBottom="20dp"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:background="@color/cyben_surface"
        android:elevation="8dp">
        <LinearLayout android:id="@+id/tabAnalizza" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128269;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Analizza" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabViolazioni" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128065;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Violazioni" android:textSize="9sp" android:textColor="@color/cyben_orange" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabVPN" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128274;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VPN" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabStorico" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128336;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Storico" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
                <LinearLayout android:id="@+id/tabImpostazioni" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9881;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Impostazioni" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>