<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0A0E1A">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/btnClose" android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="Chiudi" android:textColor="#4DA6FF" android:textSize="15sp"
            android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/chip_close_bg" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <!-- Icon -->
            <TextView android:layout_width="80dp" android:layout_height="80dp"
                android:text="📞" android:textSize="32sp" android:gravity="center"
                android:background="@drawable/icon_bg_blue" android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"/>

            <!-- Title -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Controlla numero" android:textColor="#FFFFFF"
                android:textSize="24sp" android:textStyle="bold" android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <!-- Subtitle -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Verifica se un numero e&#39; stato segnalato come spam o truffa dalla community."
                android:textColor="#8899AA" android:textSize="14sp" android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <!-- Input section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/input_bg" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📞" android:textSize="18sp" android:layout_marginEnd="10dp"
                    android:textColor="#4DA6FF"/>
                <EditText android:id="@+id/etPhoneNumber" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:hint="Inserisci il numero" android:textColor="#FFFFFF"
                    android:textColorHint="#556677" android:background="@null"
                    android:inputType="phone" android:textSize="15sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Aggiungi il prefisso internazionale se possibile"
                android:textColor="#556677" android:textSize="12sp" android:layout_marginBottom="20dp"/>

            <!-- Check button -->
            <LinearLayout android:id="@+id/btnCheckPhone" android:layout_width="match_parent"
                android:layout_height="52dp" android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/btn_dark_rounded" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true">
                <ProgressBar android:id="@+id/progressPhone" android:layout_width="20dp" android:layout_height="20dp"
                    android:visibility="gone" android:layout_marginEnd="10dp"/>
                <TextView android:id="@+id/tvCheckLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Controlla"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Result card (hidden initially) -->
            <LinearLayout android:id="@+id/cardResult" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/settings_card_bg" android:padding="20dp"
                android:layout_marginBottom="24dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/tvResultScore" android:layout_width="64dp" android:layout_height="64dp"
                        android:text="--" android:textSize="22sp" android:textStyle="bold"
                        android:gravity="center" android:background="@drawable/icon_bg_blue"
                        android:textColor="#FFFFFF" android:layout_marginEnd="16dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvResultLabel" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="---"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                        <TextView android:id="@+id/tvResultNumber" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text=""
                            android:textSize="13sp" android:textColor="#8899AA"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/tvResultExplanation" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="#AABBCC" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Report section -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Segnala questo numero" android:textColor="#FFFFFF"
                android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>

            <!-- Category chips -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:layout_marginBottom="14dp">
                <LinearLayout android:id="@+id/chipGroup" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"/>
            </HorizontalScrollView>

            <!-- Description -->
            <EditText android:id="@+id/etReportDesc" android:layout_width="match_parent"
                android:layout_height="96dp" android:hint="Descrivi cosa e&#39; successo"
                android:textColor="#FFFFFF" android:textColorHint="#556677"
                android:background="@drawable/input_bg" android:padding="14dp"
                android:gravity="top|start" android:inputType="textMultiLine"
                android:textSize="14sp" android:layout_marginBottom="14dp"/>

            <!-- Send report button -->
            <LinearLayout android:id="@+id/btnSendReport" android:layout_width="match_parent"
                android:layout_height="52dp" android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/btn_dark_rounded"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Invia segnalazione" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
