<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView android:id="@+id/previewView"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <!-- Scan frame overlay -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center">
        <View android:layout_width="240dp" android:layout_height="240dp"
            android:background="@drawable/qr_scan_frame"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Inquadra il codice QR" android:textColor="#FFFFFF"
            android:textSize="14sp" android:layout_marginTop="24dp"/>
    </LinearLayout>

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
        android:background="#88000000">
        <ImageButton android:id="@+id/btnBackQr" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Scansiona QR" android:textColor="#FFFFFF"
            android:textSize="18sp" android:textStyle="bold" android:layout_marginStart="12dp"/>
    </LinearLayout>
</FrameLayout>
