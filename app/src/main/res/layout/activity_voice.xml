<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D1A">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
        android:background="#131325">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary" android:layout_marginEnd="8dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CyAgent" android:textColor="@color/text_primary"
                    android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" BETA" android:textColor="@color/cyben_orange"
                    android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Agente AI · Analisi truffe e sicurezza"
                android:textColor="@color/text_secondary" android:textSize="10sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvSessionStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Pronto"
            android:textColor="#66BB6A" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Risk badge (visible during active session) -->
    <LinearLayout android:id="@+id/tvRiskBadge" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center" android:padding="8dp" android:background="#1A0D0D"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RISCHIO: " android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <TextView android:id="@+id/tvRiskLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="BASSO"
            android:textColor="#66BB6A" android:textSize="13sp" android:textStyle="bold"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp"
            android:paddingBottom="2dp" android:background="@drawable/risk_badge_bg"/>
    </LinearLayout>

    <!-- Chat messages -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCyAgentChat"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:clipToPadding="false"/>

    <!-- Suggested question chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <LinearLayout android:id="@+id/chipContainer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>

    <ProgressBar android:id="@+id/progressCyAgent" android:layout_width="wrap_content"
        android:layout_height="24dp" android:visibility="gone"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="4dp"/>

    <!-- Voice control panel -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#131325" android:padding="16dp">

        <!-- Animated rings + mic button -->
        <FrameLayout android:layout_width="120dp" android:layout_height="120dp"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp">
            <View android:id="@+id/ringOuter" android:layout_width="120dp" android:layout_height="120dp"
                android:background="@drawable/circle_pulse_outer" android:layout_gravity="center"/>
            <View android:id="@+id/ringInner" android:layout_width="100dp" android:layout_height="100dp"
                android:background="@drawable/circle_pulse_inner" android:layout_gravity="center"/>
            <LinearLayout android:id="@+id/btnVoiceMic"
                android:layout_width="80dp" android:layout_height="80dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/mic_button_bg"
                android:clickable="true" android:focusable="true"
                android:elevation="6dp" android:layout_gravity="center">
                <TextView android:id="@+id/tvMicIcon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="&#127897;" android:textSize="28sp"/>
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/tvSessionState" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Premi per parlare"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp"/>

        <!-- Text input -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <EditText android:id="@+id/etVoiceText" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Scrivi invece di parlare..."
                android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                android:background="@drawable/input_bg" android:inputType="text"
                android:padding="10dp" android:textSize="14sp"/>
            <ImageButton android:id="@+id/btnVoiceSend" android:layout_width="44dp"
                android:layout_height="44dp" android:src="@android:drawable/ic_menu_send"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/cyben_orange" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- End session button (shown only during call session) -->
        <Button android:id="@+id/btnEndSession" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Termina sessione"
            android:backgroundTint="#C62828" android:textColor="@color/white"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Bottom nav -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:background="@color/cyben_surface"
        android:elevation="8dp">
        <LinearLayout android:id="@+id/tabAnalizza" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128269;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Analizza" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabViolazioni" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128065;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Violazioni" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabVPN" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128274;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VPN" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabStorico" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128336;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Storico" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabImpostazioni" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9881;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Impostazioni" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
