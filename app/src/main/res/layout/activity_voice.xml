<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D1A">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
        android:background="#131325">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary" android:layout_marginEnd="8dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CyAgent" android:textColor="@color/text_primary"
                    android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" BETA" android:textColor="@color/cyben_orange"
                    android:textSize="10sp" android:textStyle="bold" android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvSessionStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Pronto"
                android:textColor="#66BB6A" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Risk badge (shown during session) -->
    <LinearLayout android:id="@+id/cardRisk" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="14dp"
        android:background="@drawable/settings_card_bg"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="60dp" android:layout_height="60dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/icon_bg_blue" android:layout_marginEnd="14dp">
            <TextView android:id="@+id/tvRiskScore" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvRiskLabel" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="IN ASCOLTO"
                android:textColor="#66BB6A" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvRiskDesc" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Analisi in corso..."
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Suggested questions chips - shown live during session -->
    <HorizontalScrollView android:id="@+id/scrollChips" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:scrollbars="none"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="8dp" android:paddingBottom="4dp"
        android:visibility="gone">
        <LinearLayout android:id="@+id/chipContainer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- Chat transcript -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCyAgentChat"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:clipToPadding="false"/>

    <!-- Controls panel -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#131325"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="8dp" android:paddingBottom="12dp">

        <!-- Buttons row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Avvia / Stop -->
            <LinearLayout android:id="@+id/btnAvvia" android:layout_width="0dp"
                android:layout_height="52dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/btn_blue" android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/tvAvviaIcon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="&#9654;"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/tvAvviaLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Avvia"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Analizza -->
            <LinearLayout android:id="@+id/btnAnalizza" android:layout_width="0dp"
                android:layout_height="52dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/btn_dark_rounded" android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true">
                <ProgressBar android:id="@+id/progressAnalisi" android:layout_width="18dp"
                    android:layout_height="18dp" android:visibility="gone" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#128269; Analizza" android:textColor="@color/cyben_orange"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Mic -->
            <LinearLayout android:id="@+id/btnMic" android:layout_width="52dp"
                android:layout_height="52dp" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/mic_button_bg"
                android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/tvMicIcon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="&#127897;" android:textSize="22sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Context input - compact single line -->
        <EditText android:id="@+id/etContext" android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Contesto (opzionale)..."
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:background="@drawable/input_bg" android:inputType="text"
            android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:textSize="13sp" android:imeOptions="actionDone"/>
    </LinearLayout>

    <!-- Bottom nav -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:background="@color/cyben_surface" android:elevation="8dp">
        <LinearLayout android:id="@+id/tabAnalizza" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128269;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Analizza" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabViolazioni" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128065;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Violazioni" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabVPN" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#128274;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VPN" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabImpostazioni" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9881;" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Impostazioni" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
